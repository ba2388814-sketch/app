"use strict";

const desktopToggle = document.getElementById("desktopToggle");
const modeDescription = document.getElementById("modeDescription");
const modeState = document.getElementById("modeState");

const fileInput = document.getElementById("extensionFile");
const chooseFile = document.getElementById("chooseFile");
const fileStatus = document.getElementById("fileStatus");
const toast = document.getElementById("toast");

const developerModal = document.getElementById("developerModal");
const closeDeveloper = document.getElementById("closeDeveloper");

let desktopEnabled = true;
let toastTimer;

try {
  const savedMode = localStorage.getItem("darkByteDesktopEnabled");
  if (savedMode !== null) {
    desktopEnabled = savedMode === "true";
  }
} catch (error) {
  // Continue with default settings.
}

function showToast(message) {
  toast.textContent = message;
  toast.classList.add("show");

  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => {
    toast.classList.remove("show");
  }, 2800);
}

function updateDesktopMode(showMessage = false) {
  desktopToggle.classList.toggle("on", desktopEnabled);
  desktopToggle.setAttribute("aria-checked", String(desktopEnabled));

  if (desktopEnabled) {
    modeDescription.textContent = "Desktop preference is ON";
    modeState.textContent = "DESKTOP ON";
    modeState.style.color = "#b3ffd4";
  } else {
    modeDescription.textContent = "Mobile-friendly preference is ON";
    modeState.textContent = "MOBILE ON";
    modeState.style.color = "#c1d2ff";
  }

  try {
    localStorage.setItem(
      "darkByteDesktopEnabled",
      String(desktopEnabled)
    );
  } catch (error) {
    // Storage might be disabled.
  }

  if (showMessage) {
    showToast(
      desktopEnabled
        ? "Desktop preference enabled. Browser support is required."
        : "Mobile preference enabled."
    );
  }
}

function openDeveloperInfo() {
  developerModal.classList.add("show");
  document.body.style.overflow = "hidden";
  closeDeveloper.focus();
}

function closeDeveloperInfo() {
  developerModal.classList.remove("show");
  document.body.style.overflow = "";
}

desktopToggle.addEventListener("click", () => {
  desktopEnabled = !desktopEnabled;
  updateDesktopMode(true);
});

document.querySelectorAll(".app-card").forEach(card => {
  card.addEventListener("click", event => {
    event.preventDefault();

    const url = card.href;
    const name = card.dataset.site || "Website";

    if (desktopEnabled) {
      showToast(
        "Opening " + name +
        ". Enable Desktop site in your browser if needed."
      );
    }

    const newTab = window.open(url, "_blank");

    if (!newTab) {
      window.location.href = url;
    }
  });
});

chooseFile.addEventListener("click", () => {
  fileInput.click();
});

fileInput.addEventListener("change", () => {
  const file = fileInput.files && fileInput.files[0];

  if (!file) {
    fileStatus.textContent = "No file selected";
    return;
  }

  fileStatus.textContent =
    file.name + " • " + formatBytes(file.size);

  showToast("File selected successfully");
});

function formatBytes(bytes) {
  if (bytes < 1024) return bytes + " B";
  if (bytes < 1024 * 1024) {
    return (bytes / 1024).toFixed(1) + " KB";
  }
  return (bytes / (1024 * 1024)).toFixed(2) + " MB";
}

developerModal.addEventListener("click", event => {
  if (event.target === developerModal) {
    closeDeveloperInfo();
  }
});

closeDeveloper.addEventListener("click", closeDeveloperInfo);

document.addEventListener("keydown", event => {
  if (event.key !== "Escape") return;

  if (developerModal.classList.contains("show")) {
    closeDeveloperInfo();
  }
});

const sections = {
  home: document.querySelector(".hero"),
  apps: document.querySelector(".apps-grid"),
  files: document.querySelector(".file-panel")
};

document.querySelectorAll(".bottom-item").forEach(button => {
  button.addEventListener("click", () => {
    const targetName = button.dataset.target;

    if (targetName === "developer") {
      openDeveloperInfo();
      return;
    }

    document.querySelectorAll(".bottom-item").forEach(item => {
      item.classList.toggle("active", item === button);
    });

    const target = sections[targetName];

    if (target) {
      target.scrollIntoView({
        behavior: "smooth",
        block: "center"
      });
    }
  });
});

updateDesktopMode(false);
</script></body>
